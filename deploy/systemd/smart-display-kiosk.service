[Unit]
Description=Smart Display kiosk session
After=network-online.target smart-display.service
Requires=smart-display.service

[Service]
Type=simple
User=pi
Group=pi
RuntimeDirectory=smart-display-kiosk
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/smart-display-kiosk
ExecStartPre=+/usr/bin/install -d -m 1777 -o root -g root /tmp/.X11-unix
ExecStart=/opt/smart-display/deploy/kiosk/start-kiosk.sh
Restart=always
RestartSec=5
# Ticket #1: under OOM pressure kill the browser before the backend.
OOMScoreAdjust=500
# Hard cap for Cog + WPE helpers. Deliberately unset until the baseline from
# scripts/measure_pi.py exists — a cap below real need turns into a restart
# loop. Measure RSS + swap, not RSS alone: zram holds a large share of the
# kiosk swapped out, so RSS understates what it needs. Suggested starting
# point: peak (RSS + swap) sum of cog + WPE over a 24 h --compare run, + 25 %.
#MemoryMax=320M

[Install]
# Ticket #17: Requires= above carries a backend stop/restart down to the
# kiosk, but not a start. Being wanted by the backend makes every
# `systemctl start smart-display` bring the kiosk back with it — including
# the automatic restart after a crash or watchdog kill, so a kiosk stopped by
# hand (e.g. for scripts/pi/test-panel-blank.sh) comes back then too. Takes
# effect only via `systemctl enable` (install-pi.sh step 7), not deploy-pi.sh.
WantedBy=multi-user.target smart-display.service
