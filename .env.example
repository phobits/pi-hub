# Application
APP_HOST=127.0.0.1
APP_PORT=8080
APP_LOCALE=de-AT
APP_TIMEZONE=Europe/Vienna
APP_DATA_DIR=./data
APP_LOG_LEVEL=INFO
APP_DEMO_MODE=false
APP_WATCH_FACE=flip
# Nachtfenster (HH:MM, leer = aus) und Freigabe für Ausschalten per Touch
APP_NIGHT_FROM=22:30
APP_NIGHT_TO=06:00
APP_ALLOW_SHUTDOWN=false

# Weather
WEATHER_ENABLED=true
WEATHER_LABEL=Zuhause
WEATHER_LATITUDE=48.2082
WEATHER_LONGITUDE=16.3738
WEATHER_TIMEOUT_SECONDS=10
# Wetter-Detailscreen (#22): GeoSphere-Stundenwerte (C-LAEF) + Regenvorschau
# (INCA) und amtliche Warnungen, beide ohne Schlüssel für die Koordinaten oben
WEATHER_GEOSPHERE_ENABLED=true
WEATHER_WARNINGS_ENABLED=true

# Calendar / CalDAV
CALENDAR_ENABLED=false
CALENDAR_URL=
CALENDAR_USERNAME=
CALENDAR_PASSWORD=
CALENDAR_NAME=
CALENDAR_TIMEOUT_SECONDS=10

# Spotify
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_DEVICE_ID=
SPOTIFY_MARKET=AT
SPOTIFY_TIMEOUT_SECONDS=10

# Screensaver / Lightroom
SCREENSAVER_ENABLED=true
SCREENSAVER_IDLE_TIMEOUT_SECONDS=120
SCREENSAVER_IMAGE_DURATION_SECONDS=15
SCREENSAVER_REFRESH_INTERVAL_SECONDS=1800
SCREENSAVER_SOURCE_URL=
SCREENSAVER_CACHE_DIR=screensaver
SCREENSAVER_DEMO_IMAGES_ENABLED=true
SCREENSAVER_TIMEOUT_SECONDS=15
SCREENSAVER_IMAGES_PER_TICK=1

# Provider refresh intervals
REFRESH_WEATHER_SECONDS=900
REFRESH_CALENDAR_SECONDS=300
REFRESH_SPOTIFY_SECONDS=10
REFRESH_LIGHTROOM_SECONDS=1800
REFRESH_WEATHER_HOURLY_SECONDS=3600
REFRESH_WEATHER_NOWCAST_SECONDS=900
REFRESH_WEATHER_WARNINGS_SECONDS=300

# pi5-Status-Screen (#24): pistatus-Endpoint des pi5 (Repo pi5-config, Port 8787).
# Leer = kein pi5-Screen. Abgefragt nur, solange der Screen sichtbar ist.
PI5_STATUS_URL=
PI5_STATUS_TIMEOUT_SECONDS=2

# Abfahrten unter den Terminen (#27), EFA der Linz AG. Leer = keine Abfahrten.
# <EFA-Haltestellen-ID>:<Linie>:<Bezeichnung>[:<Gehminuten>], kommagetrennt, z. B.
# 60501350:70:Schiffswerft,60500097:46:Hafenportal
# Abgefragt nur an TRANSIT_DAYS (ISO, 1 = Montag) im Fenster und nur, solange
# der Homescreen sichtbar ist.
TRANSIT_STOPS=
TRANSIT_WINDOW=06:00-10:00
TRANSIT_DAYS=1-5
TRANSIT_DEPARTURES=3
